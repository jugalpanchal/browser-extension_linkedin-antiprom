{
    "manifest_version": 3,
    "name": "Linkedin remote promoted posts",
    "version": "1.1.5",
    "description": "Remove promoted stuff",
    "permissions": [
        "storage"
    ],
    "options_page": "options.html",
    "content_scripts": [
        {
            "matches": [
                "https://www.linkedin.com/*"
            ],
            "js": [
                "index.global.js"
            ]
        }
    ]
}
