{
    "manifest_version": 3,
    "name": "Linkedin remote promoted posts",
    "version": "1.1.2",

    "description": "Remove promoted stuff",

    "permissions": ["storage"],

    "options_page": "options.html",

    "content_scripts": [
        {
            "matches": ["https://www.linkedin.com/feed*"],
            "js": ["index.global.js"]
        }
    ]
}
